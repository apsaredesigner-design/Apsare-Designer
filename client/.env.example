# Copy to .env.local (gitignored). Next.js loads it for next dev/build/start and
# prisma.config.ts loads it for the Prisma CLI.

# Browser → API base URL. Defaults to the same-origin Route Handlers ("/api"), so
# leave it unset unless the API is served from another origin.
# NEXT_PUBLIC_API_URL=/api

# ─── Server-only (never prefix these with NEXT_PUBLIC_) ───
CLIENT_URL=http://localhost:3000

# Postgres (see docker-compose.yml at repo root). Local dev default:
DATABASE_URL="postgresql://apsare:apsare@localhost:5432/apsare"

# Production: point this at a Neon (https://neon.tech) project's connection string instead.
# Neon's pooled endpoint (PgBouncer, "-pooler" in the hostname) is fine for the app at
# runtime:
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/apsare?sslmode=require"
#
# If you ever need to run `prisma migrate` directly against Neon (rather than local
# Postgres), use the UNPOOLED string instead — PgBouncer transaction pooling doesn't
# support the prepared statements Prisma's migrate engine needs:
# DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/apsare?sslmode=require"

# Auth: at least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

# Cloudinary (empty = dev-local uploads under public/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments: cod | razorpay | stripe
PAYMENT_PROVIDER=cod

# Email: console (logs emails, dev) | resend (needs RESEND_API_KEY)
MAIL_PROVIDER=console
MAIL_FROM="Label Apsáre <no-reply@labelapsare.com>"
ADMIN_NOTIFY_EMAIL=admin@labelapsare.com
RESEND_API_KEY=

# Rate limits: RATE_LIMIT_<NAME>=n overrides a limit (see docs/API.md).
# RATE_LIMIT_DISABLED=1 (or NODE_ENV=test) turns every limiter off.
RATE_LIMIT_DISABLED=0

# Client IP for rate limiting. 1 = trust the last X-Forwarded-For hop (set it behind
# a reverse proxy / load balancer). 0 = there is no trustworthy client IP in a Route
# Handler, so every guest shares ONE IP bucket ("ip:unknown"): set 1 in production.
TRUST_PROXY=0

# Seed (npm run db:seed -w client). Refuses NODE_ENV=production.
SEED_ADMIN_PASSWORD=Admin@12345
