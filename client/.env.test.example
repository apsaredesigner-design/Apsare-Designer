# Optional overrides for `npm test -w client` (copy to client/.env.test). Real env vars win.
# Defaults are shown. The suite refuses any database whose name does not end in _test,
# and it wipes and re-seeds that database on every run: never point it at real data.

TEST_DATABASE_URL="postgresql://apsare:apsare@127.0.0.1:5432/apsare_test"

# Password the seed gives admin@labelapsare.com in the test database.
TEST_ADMIN_PASSWORD=Admin@Test123
