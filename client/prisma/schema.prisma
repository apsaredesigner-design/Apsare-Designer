// Label Apsáre — data model. Money is stored as Decimal(10,2) in INR.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & auth ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                Int       @id @default(autoincrement())
  fullName          String
  email             String    @unique
  mobile            String    @unique
  passwordHash      String
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  /// Sessions (JWTs) issued before this instant are rejected; set on password change/reset.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  addresses     Address[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  reviews       Review[]
  resetTokens   PasswordResetToken[]
  auditLogs     AdminAuditLog[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  fullName  String
  mobile    String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String   @db.VarChar(6)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catalog ──────────────────────────────────────────────────

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  parentId    Int?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
}

model Product {
  id               Int      @id @default(autoincrement())
  code             String   @unique // product code / style number, searchable
  name             String
  slug             String   @unique
  brand            String   @default("Label Apsáre")
  description      String   @db.Text
  categoryId       Int
  fabric           String?
  occasion         String?
  pattern          String?
  careInstructions String?  @db.Text
  specs            Json? // free-form key/value specs, e.g. {"Saree length":"5.5 m","Blouse piece":"Yes"}
  mrp              Decimal  @db.Decimal(10, 2)
  salePrice        Decimal  @db.Decimal(10, 2)
  discountPercent  Int      @default(0) // derived from mrp/salePrice on save, stored for filter/sort
  isActive         Boolean  @default(true)
  isNewArrival     Boolean  @default(false)
  isTrending       Boolean  @default(false)
  isBestSeller     Boolean  @default(false)
  isDealOfDay      Boolean  @default(false)
  ratingAvg        Decimal  @default(0) @db.Decimal(2, 1)
  ratingCount      Int      @default(0)
  soldCount        Int      @default(0) // popularity sort
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([salePrice])
  @@index([discountPercent])
  @@index([soldCount])
  @@index([ratingAvg])
  // Search uses raw SQL: a functional GIN index over to_tsvector(...) is created by a
  // migration (see prisma/migrations), since Prisma's schema has no tsvector column type.
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  publicId  String? // Cloudinary public_id, used for deletion
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// One sellable SKU = product + size + colour. Stock lives here.
model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  sku       String  @unique
  size      String // e.g. "Free Size", "S", "M", "38"
  color     String
  colorHex  String? @db.VarChar(7)
  stock     Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([size])
  @@index([color])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt])
  @@index([rating])
}

// ─── Cart & wishlist ──────────────────────────────────────────

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  variantId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// ─── Coupons ──────────────────────────────────────────────────

enum CouponType {
  PERCENT
  FLAT
}

model Coupon {
  id             Int        @id @default(autoincrement())
  code           String     @unique
  description    String?
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  maxDiscount    Decimal?   @db.Decimal(10, 2)
  minOrderAmount Decimal    @default(0) @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int        @default(0)
  /// Max non-cancelled orders per customer with this coupon (null = no per-user limit).
  perUserLimit   Int?
  /// Only for customers with no non-cancelled order yet.
  firstOrderOnly Boolean    @default(false)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  orders Order[]
}

// ─── Orders & payments ────────────────────────────────────────

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  UPI
  CARD
  NET_BANKING
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id             Int           @id @default(autoincrement())
  orderNumber    String        @unique // human-facing id, e.g. APS-20260926-0001
  userId         Int
  status         OrderStatus   @default(PLACED)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  totalMrp       Decimal       @db.Decimal(10, 2)
  totalDiscount  Decimal       @db.Decimal(10, 2)
  couponId       Int?
  couponDiscount Decimal       @default(0) @db.Decimal(10, 2)
  deliveryCharge Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount    Decimal       @db.Decimal(10, 2)
  // Address is snapshotted so later edits don't change past orders
  shipName       String
  shipMobile     String
  shipLine1      String
  shipLine2      String?
  shipLandmark   String?
  shipCity       String
  shipState      String
  shipPincode    String        @db.VarChar(6)
  /// `${userId}:${Idempotency-Key}` from POST /api/orders; a replay returns this order.
  idempotencyKey String?       @unique @db.VarChar(191)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([couponId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  variantId   Int
  // Snapshot of product at purchase time
  productName String
  productCode String
  imageUrl    String?
  size        String
  color       String
  mrp         Decimal @db.Decimal(10, 2)
  salePrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id          Int           @id @default(autoincrement())
  orderId     Int
  provider    String // "cod" | "razorpay" | "stripe"
  providerRef String?
  amount      Decimal       @db.Decimal(10, 2)
  status      PaymentStatus @default(PENDING)
  raw         Json?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRef])
}

// ─── Storefront content ───────────────────────────────────────

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
}

model ServiceablePincode {
  pincode      String  @id @db.VarChar(6)
  deliveryDays Int     @default(5)
  codAvailable Boolean @default(true)
}

/// Singleton row (id = 1) holding store-wide settings the admin can edit.
model StoreSetting {
  id                    Int      @id @default(1)
  deliveryCharge        Decimal  @default(99) @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @default(1999) @db.Decimal(10, 2)
  codFee                Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt             DateTime @updatedAt
}

// ─── Operations ───────────────────────────────────────────────

/// One row per mutating admin request (written after the response). Never stores bodies.
model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  method    String   @db.VarChar(10)
  path      String   @db.VarChar(500)
  status    Int
  targetId  String?  @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  // No cascade: deleting an admin with audit history is refused.
  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([createdAt])
}

/// Contact-form submissions (POST /api/contact).
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(191)
  phone     String?  @db.VarChar(20)
  subject   String   @db.VarChar(150)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@index([createdAt])
}
